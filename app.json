{
  "expo": {
    "name": "CareBridge",
    "slug": "carebridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F5E63",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.carebridge.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "CareBridge",
      "themeColor": "#E5E8CE",
      "backgroundColor": "#E5E8CE"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "CareBridge uses the camera to scan patient health ID QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CareBridge records your location when you check in and out of a care visit."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CareBridge lets you upload photos of prescriptions and reports."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mark.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#E5E8CE"
        }
      ]
    ],
    "scheme": "carebridge",
    "backgroundColor": "#E5E8CE",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "89249618-9970-48a0-93f3-a8b797be8a33"
      }
    },
    "owner": "nihalayoob"
  }
}